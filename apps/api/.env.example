# API Environment Template — SchoolERP India
# DO NOT COMMIT REAL SECRETS OR CREDENTIALS

NODE_ENV=development
PORT=3000

# Database & Redis Connection
DATABASE_URL=postgresql://schoolerp:CHANGE_ME@localhost:5432/schoolerp
REDIS_URL=redis://localhost:6379

# Authentication Keys (Placeholders)
JWT_PRIVATE_KEY=<GENERATED_IN_SECRET_MANAGER>
JWT_PUBLIC_KEY=<GENERATED_IN_SECRET_MANAGER>

# Security & CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3001
