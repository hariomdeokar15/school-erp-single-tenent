# Environment Variables Template — SchoolERP India
# DO NOT COMMIT REAL SECRETS OR CREDENTIALS TO SOURCE CONTROL


NODE_ENV=development
PORT=3000


# Database & Cache Configuration
DATABASE_URL=postgresql://schoolerp:CHANGE_ME_LOCAL_ONLY@localhost:5432/schoolerp
REDIS_URL=redis://localhost:6379


# Authentication Keys (Placeholders — DO NOT commit actual RSA/EC private keys)
JWT_PRIVATE_KEY=<GENERATED_IN_SECRET_MANAGER>
JWT_PUBLIC_KEY=<GENERATED_IN_SECRET_MANAGER>


# Security & CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3001


# Comma-separated, opt-in server feature flags. Empty disables all flags.
FEATURE_FLAGS=


# Web Application API Base Endpoint
VITE_API_BASE_URL=http://localhost:3000

# Auth recovery — use a locally generated 32-byte key; never commit a real key.
# Generate with: openssl rand -base64 32
# Set EMAIL_OUTBOX_KEYS to JSON, e.g. {"local-v1":"<generated-base64-key>"}.
AUTH_FRONTEND_ORIGIN=http://localhost:3001
EMAIL_TRANSPORT=test
EMAIL_OUTBOX_KEYS=
EMAIL_OUTBOX_ACTIVE_KEY_VERSION=local-v1
ALLOW_LIVE_EMAILS=false
BREVO_SENSITIVE_RETENTION_CONFIRMED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SchoolERP
AUTH_RESET_TOKEN_TTL_MINUTES=15
AUTH_RESET_IP_BURST_LIMIT=30
AUTH_RESET_IP_HOURLY_LIMIT=300
