# Environment Variables Template — SchoolERP India
# DO NOT COMMIT REAL SECRETS OR CREDENTIALS TO SOURCE CONTROL

NODE_ENV=development
PORT=3000

# Database & Cache Configuration
DATABASE_URL=postgresql://schoolerp:CHANGE_ME@localhost:5432/schoolerp
REDIS_URL=redis://localhost:6379

# Authentication Keys (Placeholders — DO NOT commit actual RSA/EC private keys)
JWT_PRIVATE_KEY=<GENERATED_IN_SECRET_MANAGER>
JWT_PUBLIC_KEY=<GENERATED_IN_SECRET_MANAGER>

# Security & CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3001

# Web Application API Base Endpoint
VITE_API_BASE_URL=http://localhost:3000
